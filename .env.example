NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000



JWT_ISSUER=dotskills-api
JWT_AUDIENCE=dotskills-web
# Generate your own unique secret per environment, minimum 32 characters (e.g. `openssl rand -hex 48`).
# Never reuse the same value across dev/staging/production, and never commit a real secret here.
JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_UNIQUE_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# SSLCommerz payment gateway (https://developer.sslcommerz.com)
SSLCOMMERZ_STORE_ID=REPLACE_WITH_STORE_ID
SSLCOMMERZ_STORE_PASSWORD=REPLACE_WITH_STORE_PASSWORD
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_SUCCESS_URL=http://localhost:4000/api/v1/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:4000/api/v1/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:4000/api/v1/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:4000/api/v1/payments/sslcommerz/ipn

# Cloudflare R2 (S3-API-compatible object storage) — used for Company logo uploads.
# Create a bucket + API token at https://dash.cloudflare.com -> R2, then enable
# public access (or connect a custom domain) to get R2_PUBLIC_URL_BASE.
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_WITH_BUCKET_NAME
R2_PUBLIC_URL_BASE=https://REPLACE_WITH_PUBLIC_BUCKET_DOMAIN

