// DotSkills SaaS — Phase 1: Access-control completion
// This schema is intentionally standalone. Run migrations with prisma.phase-1.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/phase-1-prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum PlatformMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CompanyMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum TenantStatus {
  DRAFT
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CompanyStatus {
  DRAFT
  ONBOARDING
  READY
  LIVE
  SUSPENDED
  CLOSED
}




enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FeatureStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum IndustryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PermissionStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}


enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum InvitationType {
  COMPANY_OWNER
  COMPANY_STAFF
  PLATFORM_MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditActorType {
  PLATFORM_MEMBER
  COMPANY_MEMBER
  SYSTEM
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum CompanyScopeType {
  COMPANY
  BRANCH
  WAREHOUSE
  POS_COUNTER
}

enum BillingStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED
}
enum BillingAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  VOID
}

enum PaymentProvider {
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}


model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String?       @unique @db.VarChar(200)
  phone             String?       @unique @db.VarChar(32)
  passwordHash      String?       @db.Text
  fullName          String        @db.VarChar(160)
  preferredLocale   String        @default("bn-BD") @db.VarChar(20)
  timezone          String        @default("Asia/Dhaka") @db.VarChar(80)
  status            AccountStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?     @db.Timestamptz(6)
  phoneVerifiedAt   DateTime?     @db.Timestamptz(6)
  passwordChangedAt DateTime?     @db.Timestamptz(6)
  failedLoginCount  Int           @default(0)
  lockedUntil       DateTime?     @db.Timestamptz(6)
  lastLoginAt       DateTime?     @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?     @db.Timestamptz(6)

  sessions           AuthSession[]
  loginEvents        LoginEvent[]
  platformMember     PlatformMember?
  companyMemberships CompanyMember[]
  createdCompanies   Company[]          @relation("CompanyCreatedBy")
  ownerInvitations   Invitation[]       @relation("InvitationForUser")
  sentInvitations    Invitation[]       @relation("InvitationSentBy")
  ownershipAssigned  CompanyOwnership[] @relation("OwnershipAssignedBy")
  auditLogs          AuditLog[]

  @@index([status, deletedAt])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  deviceId         String?   @db.VarChar(160)
  ipAddress        String?   @db.Inet
  userAgent        String?   @db.Text
  issuedAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  revokeReason     String?   @db.VarChar(120)
  replacedByHash   String?   @db.Char(64)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model LoginEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  email      String?  @db.VarChar(200)
  success    Boolean
  reason     String?  @db.VarChar(120)
  ipAddress  String?  @db.Inet
  userAgent  String?  @db.Text
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([email, occurredAt])
  @@index([success, occurredAt])
  @@map("login_events")
}

model PlatformMember {
  id           String                   @id @default(uuid()) @db.Uuid
  userId       String                   @unique @db.Uuid
  employeeCode String?                  @unique @db.VarChar(50)
  status       PlatformMembershipStatus @default(INVITED)
  invitedAt    DateTime?                @db.Timestamptz(6)
  activatedAt  DateTime?                @db.Timestamptz(6)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(6)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        PlatformMemberRole[]

  @@index([status])
  @@map("platform_members")
}

model PlatformRole {
  id          String                   @id @default(uuid()) @db.Uuid
  code        String                   @unique @db.VarChar(60)
  name        String                   @db.VarChar(120)
  description String?                  @db.Text
  status      RoleStatus               @default(ACTIVE)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(6)
  members     PlatformMemberRole[]
  isSystem    Boolean                  @default(false)
  permissions PlatformRolePermission[]

  @@index([status])
  @@map("platform_roles")
}

model PlatformMemberRole {
  platformMemberId String         @db.Uuid
  platformRoleId   String         @db.Uuid
  assignedAt       DateTime       @default(now()) @db.Timestamptz(6)
  assignedByUserId String?        @db.Uuid
  platformMember   PlatformMember @relation(fields: [platformMemberId], references: [id], onDelete: Cascade)
  platformRole     PlatformRole   @relation(fields: [platformRoleId], references: [id], onDelete: Restrict)

  @@id([platformMemberId, platformRoleId])
  @@index([platformRoleId])
  @@map("platform_member_roles")
}

model Feature {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(80)
  name         String        @db.VarChar(120)
  module       String        @db.VarChar(80)
  description  String?       @db.Text
  status       FeatureStatus @default(ACTIVE)
  configSchema Json?         @db.JsonB

  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  planFeatures PlanFeature[]

  @@index([module, status])
  @@map("features")
}

model Plan {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique @db.VarChar(50)
  name           String         @db.VarChar(120)
  description    String?        @db.Text
  trialDays      Int            @default(0)
  isPublic       Boolean        @default(true)
  isDefaultTrial Boolean        @default(false)
  status         PlanStatus     @default(ACTIVE)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  prices         PlanPrice[]
  features       PlanFeature[]
  subscriptions  Subscription[]

  @@index([status, isPublic])
  @@index([isDefaultTrial])
  @@map("plans")
}

model PlanPrice {
  id            String       @id @default(uuid()) @db.Uuid
  planId        String       @db.Uuid
  billingCycle  BillingCycle
  currencyCode  String       @default("BDT") @db.Char(3)
  amount        Decimal      @db.Decimal(20, 4)
  effectiveFrom DateTime     @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime?    @db.Timestamptz(6)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  plan          Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingCycle, currencyCode, effectiveFrom])
  @@index([planId, billingCycle, isActive, effectiveFrom])
  @@map("plan_prices")
}

model PlanFeature {
  planId    String   @db.Uuid
  featureId String   @db.Uuid
  enabled   Boolean  @default(true)
  limits    Json?    @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

model Tenant {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique @db.VarChar(40)
  name          String             @db.VarChar(160)
  slug          String             @unique @db.VarChar(120)
  status        TenantStatus       @default(DRAFT)
  trialEndsAt   DateTime?          @db.Timestamptz(6)
  activatedAt   DateTime?          @db.Timestamptz(6)
  suspendedAt   DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  companies     Company[]
  members       CompanyMember[]
  companyRoles  CompanyRole[]
  ownerships    CompanyOwnership[]
  subscriptions Subscription[]
  billings      Billing[]
  invoices      Invoice[]
  payments      Payment[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  locations       Location[]
  categories      Category[]
  units           Unit[]
  products        Product[]
  customers       Customer[]
  suppliers       Supplier[]
  companySettings CompanySettings[]
  inventoryBalances Inventory[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  purchaseReturns   PurchaseReturn[]
  stockTransfers    StockTransfer[]
  supplierPayableLedgerEntries SupplierPayableLedger[]
  sales             Sale[]
  saleReturns       SaleReturn[]
  customerDueLedgerEntries CustomerDueLedger[]
  cashDrawerSessions CashDrawerSession[]
  stockAdjustments  StockAdjustment[]
  companyMemberLocations CompanyMemberLocation[]

  @@index([status, trialEndsAt])
  @@map("tenants")
}

model Industry {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(120)
  description String?    @db.Text
    status IndustryStatus @default(ACTIVE)


  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  companies   Company[]

  @@map("industries")
}

model Company {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  industryId       String             @db.Uuid
  createdByUserId  String?            @db.Uuid
  code             String             @db.VarChar(40)
  legalName        String             @db.VarChar(200)
  tradeName        String?            @db.VarChar(200)
  email            String?            @db.VarChar(200)
  phone            String?            @db.VarChar(32)
  taxId            String?            @db.VarChar(80)
  registrationNo   String?            @db.VarChar(80)
  baseCurrencyCode String             @default("BDT") @db.Char(3)
  timezone         String             @default("Asia/Dhaka") @db.VarChar(80)
  status           CompanyStatus      @default(DRAFT)
  goLiveAt         DateTime?          @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  industry         Industry           @relation(fields: [industryId], references: [id], onDelete: Restrict)
  createdBy        User?              @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  members          CompanyMember[]
  roles            CompanyRole[]
  ownerships       CompanyOwnership[]
  subscriptions    Subscription[]
  billings         Billing[]
  invoices         Invoice[]
  payments         Payment[]
  invitations      Invitation[]
  auditLogs        AuditLog[]
  locations        Location[]
  categories       Category[]
  units            Unit[]
  products         Product[]
  customers        Customer[]
  suppliers        Supplier[]
  companySettings  CompanySettings?
  inventoryBalances Inventory[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  purchaseReturns   PurchaseReturn[]
  stockTransfers    StockTransfer[]
  supplierPayableLedgerEntries SupplierPayableLedger[]
  sales             Sale[]
  saleReturns       SaleReturn[]
  customerDueLedgerEntries CustomerDueLedger[]
  cashDrawerSessions CashDrawerSession[]
  stockAdjustments  StockAdjustment[]
  companyMemberLocations CompanyMemberLocation[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([industryId, status])
  @@map("companies")
}

// ============================================================
// BUSINESS OPERATIONS — MASTER DATA (Phase 1)
// ============================================================

enum LocationType {
  BRANCH
  WAREHOUSE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

model Location {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  companyId      String         @db.Uuid
  name           String         @db.VarChar(120)
  locationType   LocationType
  address        String?        @db.Text
  isSalesEnabled Boolean        @default(true)
  status         LocationStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryBalances Inventory[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  transfersFrom     StockTransfer[] @relation("TransferFromLocation")
  transfersTo       StockTransfer[] @relation("TransferToLocation")
  sales             Sale[]
  cashDrawerSessions CashDrawerSession[]
  memberAssignments  CompanyMemberLocation[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, status])
  @@map("locations")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid
  companyId        String         @db.Uuid
  parentCategoryId String?        @db.Uuid
  name             String         @db.VarChar(120)
  status           CategoryStatus @default(ACTIVE)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parentCategory   Category?      @relation("CategoryParent", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories  Category[]     @relation("CategoryParent")
  products         Product[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, status])
  @@map("categories")
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

model Unit {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  companyId        String     @db.Uuid
  baseUnitId       String?    @db.Uuid
  name             String     @db.VarChar(60)
  code             String     @db.VarChar(20)
  conversionFactor Decimal    @default(1) @db.Decimal(14, 4)
  status           UnitStatus @default(ACTIVE)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  baseUnit         Unit?      @relation("UnitConversion", fields: [baseUnitId], references: [id], onDelete: Restrict)
  derivedUnits     Unit[]     @relation("UnitConversion")
  products         Product[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId, status])
  @@map("units")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  companyId    String        @db.Uuid
  categoryId   String?       @db.Uuid
  baseUnitId   String        @db.Uuid
  sku          String        @db.VarChar(60)
  barcode      String?       @db.VarChar(64)
  name         String        @db.VarChar(200)
  costPrice    Decimal       @default(0) @db.Decimal(20, 4)
  salePrice    Decimal       @default(0) @db.Decimal(20, 4)
  reorderLevel Decimal       @default(0) @db.Decimal(14, 4)
  sellByWeight Boolean       @default(false)
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUnit     Unit          @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  inventoryBalances Inventory[]
  stockMovements    StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransfers     StockTransfer[]
  saleItems          SaleItem[]

  @@unique([tenantId, companyId, sku])
  @@unique([tenantId, companyId, barcode])
  @@index([tenantId, companyId, status])
  @@index([categoryId])
  @@map("products")
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  companyId    String         @db.Uuid
  name         String         @db.VarChar(160)
  phone        String?        @db.VarChar(32)
  email        String?        @db.VarChar(200)
  address      String?        @db.Text
  customerType CustomerType   @default(RETAIL)
  dueBalance   Decimal        @default(0) @db.Decimal(20, 4)
  status       CustomerStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sales                  Sale[]
  customerDueLedgerEntries CustomerDueLedger[]

  @@unique([tenantId, companyId, phone])
  @@index([tenantId, companyId, status])
  @@map("customers")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  companyId      String         @db.Uuid
  name           String         @db.VarChar(160)
  phone          String?        @db.VarChar(32)
  email          String?        @db.VarChar(200)
  address        String?        @db.Text
  payableBalance Decimal        @default(0) @db.Decimal(20, 4)
  status         SupplierStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrders       PurchaseOrder[]
  payableLedgerEntries SupplierPayableLedger[]

  @@unique([tenantId, companyId, phone])
  @@index([tenantId, companyId, status])
  @@map("suppliers")
}

// ============================================================
// BUSINESS OPERATIONS — INVENTORY LEDGER (Phase 2)
// ============================================================

model Inventory {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  companyId  String   @db.Uuid
  productId  String   @db.Uuid
  locationId String   @db.Uuid
  quantity   Decimal  @default(0) @db.Decimal(14, 4)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, companyId, locationId, productId])
  @@index([tenantId, companyId, productId])
  @@map("inventory")
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  SALE_RETURN_IN
  PURCHASE_RETURN_OUT
  SALE_VOID_IN
}

model StockMovement {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @db.Uuid
  companyId     String                 @db.Uuid
  productId     String                 @db.Uuid
  locationId    String                 @db.Uuid
  movementType  StockMovementType
  changeQty     Decimal                @db.Decimal(14, 4)
  balanceAfter  Decimal                @db.Decimal(14, 4)
  unitCost      Decimal?               @db.Decimal(20, 4)
  /** Only ever populated for ADJUSTMENT-type rows — null for every other movement type. */
  reason        StockAdjustmentReason?
  referenceId   String?                @db.Uuid
  actorUserId   String?                @db.Uuid
  note          String?                @db.Text
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  location      Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId, productId, locationId, createdAt])
  @@map("stock_movements")
}

enum StockAdjustmentReason {
  DAMAGE
  THEFT_SHRINKAGE
  COUNT_MISMATCH
  EXPIRED
  OPENING_STOCK
  OTHER
}

/**
 * A lightweight batch header — the same "header row + per-line
 * StockMovement rows referencing it" shape GoodsReceipt/PurchaseReturn/
 * SaleReturn already use, not a new concept. `reason` lives on each
 * StockMovement line (not here) since one bulk submission can legitimately
 * mix reasons (e.g. a physical count session finding both DAMAGE and
 * COUNT_MISMATCH lines) — this header exists so a multi-line submission is
 * traceable as one event, and as StockMovement.referenceId's target.
 */
model StockAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyId   String   @db.Uuid
  actorUserId String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId, createdAt])
  @@map("stock_adjustments")
}

// ============================================================
// BUSINESS OPERATIONS — PURCHASE + STOCK TRANSFER (Phase 3)
// ============================================================

enum PurchaseOrderStatus {
  DRAFT
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

/**
 * Company-scoped order-number sequence — deliberately NOT a global counter
 * like InvoiceSequence. The design document's own Section 9.1 explicitly
 * flags a shared global sequence as a multi-tenant leak (Company A's order
 * volume becomes inferable from Company B's numbers) — Invoice is a
 * platform-billing document where that risk doesn't apply the same way,
 * but PurchaseOrder is company-owned business data, so it gets its own
 * per-(tenant,company) sequence instead.
 */
model PurchaseOrderSequence {
  tenantId   String @db.Uuid
  companyId  String @db.Uuid
  yearKey    String @db.VarChar(4)
  lastNumber Int    @default(0)

  @@id([tenantId, companyId, yearKey])
  @@map("purchase_order_sequences")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  companyId   String              @db.Uuid
  supplierId  String              @db.Uuid
  locationId  String              @db.Uuid
  orderNumber String              @db.VarChar(40)
  status      PurchaseOrderStatus @default(DRAFT)
  orderDate   DateTime            @default(now()) @db.Timestamptz(6)
  totalAmount Decimal             @default(0) @db.Decimal(20, 4)
  note        String?             @db.Text
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  receipts    GoodsReceipt[]
  returns     PurchaseReturn[]

  @@unique([tenantId, companyId, orderNumber])
  @@index([tenantId, companyId, status, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  productId       String        @db.Uuid
  orderedQty      Decimal       @db.Decimal(14, 4)
  receivedQty     Decimal       @default(0) @db.Decimal(14, 4)
  unitCost        Decimal       @db.Decimal(20, 4)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  companyId       String        @db.Uuid
  purchaseOrderId String        @db.Uuid
  receivedDate    DateTime      @default(now()) @db.Timestamptz(6)
  billImageUrl    String?       @db.Text
  actorUserId     String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId, purchaseOrderId])
  @@map("goods_receipts")
}

model PurchaseReturn {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  companyId       String        @db.Uuid
  purchaseOrderId String        @db.Uuid
  reason          String        @db.Text
  refundAmount    Decimal       @default(0) @db.Decimal(20, 4)
  returnDate      DateTime      @default(now()) @db.Timestamptz(6)
  actorUserId     String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId, purchaseOrderId])
  @@map("purchase_returns")
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  companyId      String               @db.Uuid
  fromLocationId String               @db.Uuid
  toLocationId   String               @db.Uuid
  productId      String               @db.Uuid
  quantity       Decimal              @db.Decimal(14, 4)
  status         StockTransferStatus  @default(PENDING)
  dispatchedAt   DateTime?            @db.Timestamptz(6)
  receivedAt     DateTime?            @db.Timestamptz(6)
  actorUserId    String?              @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fromLocation   Location             @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation     Location             @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId, status])
  @@map("stock_transfers")
}

enum SupplierLedgerEntryType {
  PAYABLE
  PAYMENT
}

model SupplierPayableLedger {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  companyId   String                  @db.Uuid
  supplierId  String                  @db.Uuid
  entryType   SupplierLedgerEntryType
  amount      Decimal                 @db.Decimal(20, 4)
  referenceId String?                 @db.Uuid
  note        String?                 @db.Text
  actorUserId String?                 @db.Uuid
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier    Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId, supplierId, createdAt])
  @@map("supplier_payable_ledger")
}

// ============================================================
// BUSINESS OPERATIONS — SALES / POS (Phase 4)
// ============================================================

/** Company-scoped, mirrors PurchaseOrderSequence exactly (see its own comment for why this is per-company, not global like InvoiceSequence). */
model SaleSequence {
  tenantId   String @db.Uuid
  companyId  String @db.Uuid
  yearKey    String @db.VarChar(4)
  lastNumber Int    @default(0)

  @@id([tenantId, companyId, yearKey])
  @@map("sale_sequences")
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

model Sale {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @db.Uuid
  companyId          String     @db.Uuid
  locationId         String     @db.Uuid
  customerId         String?    @db.Uuid
  processedByUserId  String     @db.Uuid
  cashDrawerSessionId String?   @db.Uuid
  saleNumber         String     @db.VarChar(40)
  status             SaleStatus @default(COMPLETED)
  saleDate           DateTime   @default(now()) @db.Timestamptz(6)
  subtotal           Decimal    @db.Decimal(20, 4)
  itemDiscountTotal  Decimal    @default(0) @db.Decimal(20, 4)
  saleDiscountAmount Decimal    @default(0) @db.Decimal(20, 4)
  taxAmount          Decimal    @default(0) @db.Decimal(20, 4)
  totalAmount        Decimal    @db.Decimal(20, 4)
  voidedAt           DateTime?  @db.Timestamptz(6)
  voidReason         String?    @db.Text
  voidedByUserId     String?    @db.Uuid
  note               String?    @db.Text
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location           Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customer           Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashDrawerSession  CashDrawerSession? @relation(fields: [cashDrawerSessionId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  payments           SalePayment[]
  returns            SaleReturn[]

  @@unique([tenantId, companyId, saleNumber])
  @@index([tenantId, companyId, status, saleDate])
  @@index([cashDrawerSessionId])
  @@map("sales")
}

model SaleItem {
  id             String  @id @default(uuid()) @db.Uuid
  saleId         String  @db.Uuid
  productId      String  @db.Uuid
  productName    String  @db.VarChar(200)
  quantity       Decimal @db.Decimal(14, 4)
  unitPrice      Decimal @db.Decimal(20, 4)
  unitCost       Decimal @db.Decimal(20, 4)
  discountAmount Decimal @default(0) @db.Decimal(20, 4)
  subtotal       Decimal @db.Decimal(20, 4)
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_items")
}

enum SalePaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  DUE
}

model SalePayment {
  id        String            @id @default(uuid()) @db.Uuid
  saleId    String            @db.Uuid
  method    SalePaymentMethod
  amount    Decimal           @db.Decimal(20, 4)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

model SaleReturn {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  companyId    String   @db.Uuid
  saleId       String   @db.Uuid
  reason       String   @db.Text
  refundAmount Decimal  @default(0) @db.Decimal(20, 4)
  returnDate   DateTime @default(now()) @db.Timestamptz(6)
  actorUserId  String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId, saleId])
  @@map("sale_returns")
}

enum CustomerLedgerEntryType {
  DUE
  PAYMENT
}

model CustomerDueLedger {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  companyId   String                  @db.Uuid
  customerId  String                  @db.Uuid
  entryType   CustomerLedgerEntryType
  amount      Decimal                 @db.Decimal(20, 4)
  referenceId String?                 @db.Uuid
  note        String?                 @db.Text
  actorUserId String?                 @db.Uuid
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId, customerId, createdAt])
  @@map("customer_due_ledger")
}

enum CashDrawerSessionStatus {
  OPEN
  CLOSED
}

/**
 * One row per cashier shift at one Location. `cashierId` is a plain field
 * (no @relation), matching StockMovement.actorUserId's existing convention.
 * The @@unique below becomes a PARTIAL unique index (WHERE status = 'OPEN')
 * via a hand-edited migration.sql — Prisma's schema DSL cannot express a
 * conditional unique constraint directly. This is what makes "one cashier,
 * one open session at a time" (regardless of Location) atomic and race-safe
 * at the database level, the correct analogue of Phase 2/4's atomic
 * conditional-update pattern applied to a create instead of an update.
 */
model CashDrawerSession {
  id                     String                   @id @default(uuid()) @db.Uuid
  tenantId               String                   @db.Uuid
  companyId              String                   @db.Uuid
  locationId             String                   @db.Uuid
  cashierId              String                   @db.Uuid
  status                 CashDrawerSessionStatus  @default(OPEN)
  shiftStart             DateTime                 @default(now()) @db.Timestamptz(6)
  shiftEnd               DateTime?                @db.Timestamptz(6)
  openingBalance         Decimal                  @db.Decimal(20, 4)
  expectedClosingBalance Decimal?                 @db.Decimal(20, 4)
  actualClosingBalance   Decimal?                 @db.Decimal(20, 4)
  variance               Decimal?                 @db.Decimal(20, 4)
  note                   String?                  @db.Text
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(6)
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location               Location                 @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sales                  Sale[]

  @@unique([tenantId, companyId, cashierId], map: "cash_drawer_sessions_one_open_per_cashier")
  @@index([tenantId, companyId, locationId, status])
  @@map("cash_drawer_sessions")
}

model CompanySettings {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  companyId            String   @unique @db.Uuid
  enableMultiUnit      Boolean  @default(true)
  enableCustomerDue    Boolean  @default(true)
  enableBarcode        Boolean  @default(true)
  enableProductVariant Boolean  @default(false)
  enableComboOffer     Boolean  @default(false)
  enableMultiLocation  Boolean  @default(false)
  allowNegativeStock   Boolean  @default(false)
  maxCustomerDueLimit  Decimal? @db.Decimal(20, 4)
  enableTax            Boolean  @default(false)
  defaultTaxRate       Decimal  @default(0) @db.Decimal(6, 3)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId])
  @@map("company_settings")
}

model CompanyMember {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @db.Uuid
  companyId    String                  @db.Uuid
  userId       String                  @db.Uuid
  employeeCode String?                 @db.VarChar(50)
  designation  String?                 @db.VarChar(120)
  status       CompanyMembershipStatus @default(INVITED)
  invitedAt    DateTime?               @db.Timestamptz(6)
  joinedAt     DateTime?               @db.Timestamptz(6)
  activatedAt  DateTime?               @db.Timestamptz(6)
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(6)
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        CompanyMemberRole[]
  scopes       CompanyMemberScope[]
  locations    CompanyMemberLocation[]
  ownerships   CompanyOwnership[]      @relation("OwnershipMember")

  @@unique([tenantId, companyId, userId])
  @@unique([tenantId, companyId, employeeCode])
  @@index([userId, status])
  @@index([tenantId, companyId, status])
  @@map("company_members")
}

model CompanyRole {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  companyId   String              @db.Uuid
  code        String              @db.VarChar(60)
  name        String              @db.VarChar(120)
  description String?             @db.Text
  isSystem    Boolean             @default(false)
  status      RoleStatus          @default(ACTIVE)

  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members     CompanyMemberRole[]

  permissions CompanyRolePermission[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId, status])
  @@map("company_roles")
}

model CompanyMemberRole {
  companyMemberId  String        @db.Uuid
  companyRoleId    String        @db.Uuid
  assignedAt       DateTime      @default(now()) @db.Timestamptz(6)
  assignedByUserId String?       @db.Uuid
  expiresAt        DateTime?     @db.Timestamptz(6)
  companyMember    CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)
  companyRole      CompanyRole   @relation(fields: [companyRoleId], references: [id], onDelete: Restrict)

  @@id([companyMemberId, companyRoleId])
  @@index([companyRoleId])
  @@map("company_member_roles")
}

model CompanyMemberScope {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  companyId        String           @db.Uuid
  companyMemberId  String           @db.Uuid
  scopeType        CompanyScopeType
  scopeKey         String           @default("*") @db.VarChar(120)
  conditions       Json?            @db.JsonB
  validFrom        DateTime         @default(now()) @db.Timestamptz(6)
  validUntil       DateTime?        @db.Timestamptz(6)
  assignedByUserId String?          @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  companyMember    CompanyMember    @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)

  @@unique([companyMemberId, scopeType, scopeKey])
  @@index([tenantId, companyId, scopeType, scopeKey, validUntil])
  @@map("company_member_scopes")
}

/**
 * Location-Based Access Control — deliberately a dedicated table, not a
 * reuse of CompanyMemberScope above: `locationId` here is a real FK
 * (onDelete: Restrict, matching every other location-touching table in
 * this module), and every existing member already carries an
 * unconditional {COMPANY, '*'} CompanyMemberScope row from creation —
 * reusing that table would mean reasoning about that legacy row's
 * interaction with real Location rows for every member. No rows here for
 * a member = no Location access at all (fail-safe default); Owner/Admin
 * are exempt via the LOCATION_ACCESS_ALL permission instead of needing
 * any rows here.
 */
model CompanyMemberLocation {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  companyId        String        @db.Uuid
  companyMemberId  String        @db.Uuid
  locationId       String        @db.Uuid
  assignedByUserId String?       @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyMember    CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)
  location         Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([companyMemberId, locationId])
  @@index([tenantId, companyId, companyMemberId])
  @@map("company_member_locations")
}

model CompanyOwnership {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  companyId        String        @db.Uuid
  companyMemberId  String        @db.Uuid
  isPrimary        Boolean       @default(false)
  startedAt        DateTime      @default(now()) @db.Timestamptz(6)
  endedAt          DateTime?     @db.Timestamptz(6)
  assignedByUserId String?       @db.Uuid
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companyMember    CompanyMember @relation("OwnershipMember", fields: [companyMemberId], references: [id], onDelete: Restrict)
  assignedBy       User?         @relation("OwnershipAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, companyId, endedAt])
  @@index([companyMemberId, endedAt])
  @@map("company_ownerships")
}




model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  companyId          String?            @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle
  startsAt           DateTime           @db.Timestamptz(6)
  trialEndsAt        DateTime?          @db.Timestamptz(6)
  currentPeriodStart DateTime           @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @db.Timestamptz(6)
  graceEndsAt        DateTime?          @db.Timestamptz(6)
  cancelledAt        DateTime?          @db.Timestamptz(6)
  autoRenew          Boolean            @default(true)
  priceSnapshot      Json               @db.JsonB
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  suspendedAt        DateTime? @db.Timestamptz(6)
  pastDueEndsAt       DateTime? @db.Timestamptz(6)
  suspensionExpiresAt DateTime? @db.Timestamptz(6)
  isComplimentary    Boolean   @default(false)
  events             SubscriptionEvent[]
  billings           Billing[]
  invoices           Invoice[]
  payments           Payment[]


  @@index([tenantId, status, currentPeriodEnd])
  @@index([companyId, status, currentPeriodEnd])
  @@map("subscriptions")

  @@index([status, trialEndsAt])
  @@index([status, pastDueEndsAt])
  @@index([status, graceEndsAt])
  @@index([status, suspensionExpiresAt])
}

model Billing {
  id                  String        @id @default(uuid()) @db.Uuid

  tenantId            String        @db.Uuid
  companyId           String?       @db.Uuid
  subscriptionId      String        @db.Uuid

  status              BillingStatus @default(PENDING)

  billingCycle        BillingCycle
  currencyCode        String        @db.Char(3)

  amount              Decimal       @db.Decimal(20, 4)

  periodStart         DateTime      @db.Timestamptz(6)
  periodEnd           DateTime      @db.Timestamptz(6)

  dueAt               DateTime      @db.Timestamptz(6)

  processedAt         DateTime?     @db.Timestamptz(6)
  failedAt            DateTime?     @db.Timestamptz(6)
  cancelledAt         DateTime?     @db.Timestamptz(6)

  attemptCount        Int           @default(0)
  nextAttemptAt       DateTime?     @db.Timestamptz(6)

  idempotencyKey      String        @unique @db.VarChar(200)

  priceSnapshot      Json          @db.JsonB

  metadata            Json?         @db.JsonB

  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company             Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subscription        Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  attempts            BillingAttempt[]
  invoice             Invoice?
  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([tenantId, status, dueAt])
  @@index([companyId, status, dueAt])
  @@index([subscriptionId, periodStart, periodEnd])
  @@index([status, nextAttemptAt])
  @@map("billings")
}














model BillingAttempt {
  id                String               @id @default(uuid()) @db.Uuid

  billingId         String               @db.Uuid

  attemptNumber     Int

  status            BillingAttemptStatus @default(STARTED)

  attemptedAt       DateTime             @default(now()) @db.Timestamptz(6)
  completedAt       DateTime?            @db.Timestamptz(6)

  failureCode       String?              @db.VarChar(100)
  failureMessage    String?              @db.Text

  idempotencyKey    String               @unique @db.VarChar(200)

  metadata          Json?                @db.JsonB

  createdAt         DateTime             @default(now()) @db.Timestamptz(6)

  billing           Billing              @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@unique([billingId, attemptNumber])
  @@index([billingId, createdAt])
  @@index([status, attemptedAt])
  @@map("billing_attempts")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid

  tenantId       String        @db.Uuid
  companyId      String?       @db.Uuid
  subscriptionId String        @db.Uuid
  billingId      String        @unique @db.Uuid

  invoiceNumber  String        @unique @db.VarChar(40)

  status         InvoiceStatus @default(DRAFT)

  currencyCode   String        @db.Char(3)
  subtotal       Decimal       @db.Decimal(20, 4)
  discountAmount Decimal       @default(0) @db.Decimal(20, 4)
  taxAmount      Decimal       @default(0) @db.Decimal(20, 4)
  totalAmount    Decimal       @db.Decimal(20, 4)

  priceSnapshot  Json          @db.JsonB

  issuedAt       DateTime?     @db.Timestamptz(6)
  dueAt          DateTime      @db.Timestamptz(6)
  paidAt         DateTime?     @db.Timestamptz(6)
  cancelledAt    DateTime?     @db.Timestamptz(6)
  voidedAt       DateTime?     @db.Timestamptz(6)

  metadata       Json?         @db.JsonB

  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  billing        Billing       @relation(fields: [billingId], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@index([tenantId, status, dueAt])
  @@index([companyId, status])
  @@index([subscriptionId, createdAt])
  @@map("invoices")
}

model InvoiceSequence {
  yearKey    String @id @db.VarChar(4)
  lastNumber Int    @default(0)

  @@map("invoice_sequences")
}

model Payment {
  id                     String          @id @default(uuid()) @db.Uuid

  tenantId               String          @db.Uuid
  companyId              String?         @db.Uuid
  subscriptionId         String          @db.Uuid
  invoiceId              String          @db.Uuid

  provider               PaymentProvider
  status                 PaymentStatus   @default(PENDING)

  currencyCode           String          @db.Char(3)
  amount                 Decimal         @db.Decimal(20, 4)

  providerTransactionId  String          @unique @db.VarChar(64)
  gatewayReference       String?         @unique @db.VarChar(64)

  idempotencyKey         String          @unique @db.VarChar(200)

  failureReason          String?         @db.Text

  rawInitiateResponse    Json?           @db.JsonB
  rawVerifyResponse      Json?           @db.JsonB
  metadata               Json?           @db.JsonB

  initiatedAt            DateTime?       @db.Timestamptz(6)
  succeededAt            DateTime?       @db.Timestamptz(6)
  failedAt               DateTime?       @db.Timestamptz(6)
  cancelledAt            DateTime?       @db.Timestamptz(6)

  createdAt              DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(6)

  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company                Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subscription            Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoice                Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([companyId, status])
  @@index([invoiceId, status])
  @@map("payments")
}




model SubscriptionEvent {
  id              String              @id @default(uuid()) @db.Uuid
  subscriptionId  String              @db.Uuid
  tenantId        String              @db.Uuid
  companyId       String?             @db.Uuid
  fromStatus      SubscriptionStatus?
  toStatus        SubscriptionStatus
  reason          String              @db.VarChar(160)
  source          String              @db.VarChar(40)
  actorUserId     String?             @db.Uuid
  idempotencyKey  String?             @unique @db.VarChar(200)
  metadata        Json?               @db.JsonB
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  subscription    Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([tenantId, companyId, createdAt])
  @@map("subscription_events")
}
model Invitation {
  id            String           @id @default(uuid()) @db.Uuid
  type          InvitationType
  status        InvitationStatus @default(PENDING)
  tenantId      String?          @db.Uuid
  companyId     String?          @db.Uuid
  invitedUserId String?          @db.Uuid
  email         String           @db.VarChar(200)
  tokenHash     String           @unique @db.Char(64)
  expiresAt     DateTime         @db.Timestamptz(6)
  acceptedAt    DateTime?        @db.Timestamptz(6)
  revokedAt     DateTime?        @db.Timestamptz(6)
  sentByUserId  String?          @db.Uuid
  metadata      Json?            @db.JsonB
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  company       Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedUser   User?            @relation("InvitationForUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  sentBy        User?            @relation("InvitationSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([email, status, expiresAt])
  @@index([tenantId, companyId, status])
  @@map("invitations")
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String?        @db.Uuid
  companyId   String?        @db.Uuid
  actorUserId String?        @db.Uuid
  actorType   AuditActorType @default(SYSTEM)
  action      String         @db.VarChar(120)
  entityType  String         @db.VarChar(100)
  entityId    String?        @db.Uuid
  requestId   String?        @db.Uuid
  ipAddress   String?        @db.Inet
  userAgent   String?        @db.Text
  beforeData  Json?          @db.JsonB
  afterData   Json?          @db.JsonB
  metadata    Json?          @db.JsonB
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, companyId, entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Permission {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(120)
  moduleCode  String     @db.VarChar(80)
  resource    String     @db.VarChar(80)
  action      String     @db.VarChar(80)
  name        String     @db.VarChar(160)
  description String?    @db.Text
  isSystem    Boolean    @default(true)
    status      PermissionStatus @default(ACTIVE)

  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  platformRoles PlatformRolePermission[]
  companyRoles  CompanyRolePermission[]

  @@unique([moduleCode, resource, action])
  @@index([moduleCode, status])
  @@index([resource, action, status])
  @@map("permissions")
}

model PlatformRolePermission {
  platformRoleId   String           @db.Uuid
  permissionId     String           @db.Uuid
  effect           PermissionEffect @default(ALLOW)
  conditions       Json?            @db.JsonB
  assignedAt       DateTime         @default(now()) @db.Timestamptz(6)
  assignedByUserId String?          @db.Uuid

  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([platformRoleId, permissionId])
  @@index([permissionId, effect])
  @@map("platform_role_permissions")
}

model CompanyRolePermission {
  companyRoleId    String           @db.Uuid
  permissionId     String           @db.Uuid
  effect           PermissionEffect @default(ALLOW)
  conditions       Json?            @db.JsonB
  assignedAt       DateTime         @default(now()) @db.Timestamptz(6)
  assignedByUserId String?          @db.Uuid

  companyRole CompanyRole @relation(fields: [companyRoleId], references: [id], onDelete: Cascade)
  permission  Permission  @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([companyRoleId, permissionId])
  @@index([permissionId, effect])
  @@map("company_role_permissions")
}
