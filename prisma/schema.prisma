// DotSkills SaaS — Phase 1: Access-control completion
// This schema is intentionally standalone. Run migrations with prisma.phase-1.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/phase-1-prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum PlatformMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CompanyMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum TenantStatus {
  DRAFT
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CompanyStatus {
  DRAFT
  ONBOARDING
  READY
  LIVE
  SUSPENDED
  CLOSED
}




enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FeatureStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum IndustryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PermissionStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}


enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum InvitationType {
  COMPANY_OWNER
  COMPANY_STAFF
  PLATFORM_MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditActorType {
  PLATFORM_MEMBER
  COMPANY_MEMBER
  SYSTEM
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum CompanyScopeType {
  COMPANY
  BRANCH
  WAREHOUSE
  POS_COUNTER
}

enum BillingStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED
}
enum BillingAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  VOID
}

enum PaymentProvider {
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}


model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String?       @unique @db.VarChar(200)
  phone             String?       @unique @db.VarChar(32)
  passwordHash      String?       @db.Text
  fullName          String        @db.VarChar(160)
  preferredLocale   String        @default("bn-BD") @db.VarChar(20)
  timezone          String        @default("Asia/Dhaka") @db.VarChar(80)
  status            AccountStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?     @db.Timestamptz(6)
  phoneVerifiedAt   DateTime?     @db.Timestamptz(6)
  passwordChangedAt DateTime?     @db.Timestamptz(6)
  failedLoginCount  Int           @default(0)
  lockedUntil       DateTime?     @db.Timestamptz(6)
  lastLoginAt       DateTime?     @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?     @db.Timestamptz(6)

  sessions           AuthSession[]
  loginEvents        LoginEvent[]
  platformMember     PlatformMember?
  companyMemberships CompanyMember[]
  createdCompanies   Company[]          @relation("CompanyCreatedBy")
  ownerInvitations   Invitation[]       @relation("InvitationForUser")
  sentInvitations    Invitation[]       @relation("InvitationSentBy")
  ownershipAssigned  CompanyOwnership[] @relation("OwnershipAssignedBy")
  auditLogs          AuditLog[]

  @@index([status, deletedAt])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  deviceId         String?   @db.VarChar(160)
  ipAddress        String?   @db.Inet
  userAgent        String?   @db.Text
  issuedAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  revokeReason     String?   @db.VarChar(120)
  replacedByHash   String?   @db.Char(64)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model LoginEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  email      String?  @db.VarChar(200)
  success    Boolean
  reason     String?  @db.VarChar(120)
  ipAddress  String?  @db.Inet
  userAgent  String?  @db.Text
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([email, occurredAt])
  @@index([success, occurredAt])
  @@map("login_events")
}

model PlatformMember {
  id           String                   @id @default(uuid()) @db.Uuid
  userId       String                   @unique @db.Uuid
  employeeCode String?                  @unique @db.VarChar(50)
  status       PlatformMembershipStatus @default(INVITED)
  invitedAt    DateTime?                @db.Timestamptz(6)
  activatedAt  DateTime?                @db.Timestamptz(6)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(6)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        PlatformMemberRole[]

  @@index([status])
  @@map("platform_members")
}

model PlatformRole {
  id          String                   @id @default(uuid()) @db.Uuid
  code        String                   @unique @db.VarChar(60)
  name        String                   @db.VarChar(120)
  description String?                  @db.Text
  status      RoleStatus               @default(ACTIVE)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(6)
  members     PlatformMemberRole[]
  isSystem    Boolean                  @default(false)
  permissions PlatformRolePermission[]

  @@index([status])
  @@map("platform_roles")
}

model PlatformMemberRole {
  platformMemberId String         @db.Uuid
  platformRoleId   String         @db.Uuid
  assignedAt       DateTime       @default(now()) @db.Timestamptz(6)
  assignedByUserId String?        @db.Uuid
  platformMember   PlatformMember @relation(fields: [platformMemberId], references: [id], onDelete: Cascade)
  platformRole     PlatformRole   @relation(fields: [platformRoleId], references: [id], onDelete: Restrict)

  @@id([platformMemberId, platformRoleId])
  @@index([platformRoleId])
  @@map("platform_member_roles")
}

model Feature {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(80)
  name         String        @db.VarChar(120)
  module       String        @db.VarChar(80)
  description  String?       @db.Text
  status       FeatureStatus @default(ACTIVE)
  configSchema Json?         @db.JsonB

  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  planFeatures PlanFeature[]

  @@index([module, status])
  @@map("features")
}

model Plan {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique @db.VarChar(50)
  name           String         @db.VarChar(120)
  description    String?        @db.Text
  trialDays      Int            @default(0)
  isPublic       Boolean        @default(true)
  isDefaultTrial Boolean        @default(false)
  status         PlanStatus     @default(ACTIVE)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  prices         PlanPrice[]
  features       PlanFeature[]
  subscriptions  Subscription[]

  @@index([status, isPublic])
  @@index([isDefaultTrial])
  @@map("plans")
}

model PlanPrice {
  id            String       @id @default(uuid()) @db.Uuid
  planId        String       @db.Uuid
  billingCycle  BillingCycle
  currencyCode  String       @default("BDT") @db.Char(3)
  amount        Decimal      @db.Decimal(20, 4)
  effectiveFrom DateTime     @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime?    @db.Timestamptz(6)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  plan          Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingCycle, currencyCode, effectiveFrom])
  @@index([planId, billingCycle, isActive, effectiveFrom])
  @@map("plan_prices")
}

model PlanFeature {
  planId    String   @db.Uuid
  featureId String   @db.Uuid
  enabled   Boolean  @default(true)
  limits    Json?    @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

model Tenant {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique @db.VarChar(40)
  name          String             @db.VarChar(160)
  slug          String             @unique @db.VarChar(120)
  status        TenantStatus       @default(DRAFT)
  trialEndsAt   DateTime?          @db.Timestamptz(6)
  activatedAt   DateTime?          @db.Timestamptz(6)
  suspendedAt   DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  companies     Company[]
  members       CompanyMember[]
  companyRoles  CompanyRole[]
  ownerships    CompanyOwnership[]
  subscriptions Subscription[]
  billings      Billing[]
  invoices      Invoice[]
  payments      Payment[]
  invitations   Invitation[]
  auditLogs     AuditLog[]

  @@index([status, trialEndsAt])
  @@map("tenants")
}

model Industry {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(120)
  description String?    @db.Text
    status IndustryStatus @default(ACTIVE)


  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  companies   Company[]

  @@map("industries")
}

model Company {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  industryId       String             @db.Uuid
  createdByUserId  String?            @db.Uuid
  code             String             @db.VarChar(40)
  legalName        String             @db.VarChar(200)
  tradeName        String?            @db.VarChar(200)
  email            String?            @db.VarChar(200)
  phone            String?            @db.VarChar(32)
  taxId            String?            @db.VarChar(80)
  registrationNo   String?            @db.VarChar(80)
  baseCurrencyCode String             @default("BDT") @db.Char(3)
  timezone         String             @default("Asia/Dhaka") @db.VarChar(80)
  status           CompanyStatus      @default(DRAFT)
  goLiveAt         DateTime?          @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  industry         Industry           @relation(fields: [industryId], references: [id], onDelete: Restrict)
  createdBy        User?              @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  members          CompanyMember[]
  roles            CompanyRole[]
  ownerships       CompanyOwnership[]
  subscriptions    Subscription[]
  billings         Billing[]
  invoices         Invoice[]
  payments         Payment[]
  invitations      Invitation[]
  auditLogs        AuditLog[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([industryId, status])
  @@map("companies")
}

model CompanyMember {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @db.Uuid
  companyId    String                  @db.Uuid
  userId       String                  @db.Uuid
  employeeCode String?                 @db.VarChar(50)
  designation  String?                 @db.VarChar(120)
  status       CompanyMembershipStatus @default(INVITED)
  invitedAt    DateTime?               @db.Timestamptz(6)
  joinedAt     DateTime?               @db.Timestamptz(6)
  activatedAt  DateTime?               @db.Timestamptz(6)
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(6)
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        CompanyMemberRole[]
  scopes       CompanyMemberScope[]
  ownerships   CompanyOwnership[]      @relation("OwnershipMember")

  @@unique([tenantId, companyId, userId])
  @@unique([tenantId, companyId, employeeCode])
  @@index([userId, status])
  @@index([tenantId, companyId, status])
  @@map("company_members")
}

model CompanyRole {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  companyId   String              @db.Uuid
  code        String              @db.VarChar(60)
  name        String              @db.VarChar(120)
  description String?             @db.Text
  isSystem    Boolean             @default(false)
  status      RoleStatus          @default(ACTIVE)

  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members     CompanyMemberRole[]

  permissions CompanyRolePermission[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId, status])
  @@map("company_roles")
}

model CompanyMemberRole {
  companyMemberId  String        @db.Uuid
  companyRoleId    String        @db.Uuid
  assignedAt       DateTime      @default(now()) @db.Timestamptz(6)
  assignedByUserId String?       @db.Uuid
  expiresAt        DateTime?     @db.Timestamptz(6)
  companyMember    CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)
  companyRole      CompanyRole   @relation(fields: [companyRoleId], references: [id], onDelete: Restrict)

  @@id([companyMemberId, companyRoleId])
  @@index([companyRoleId])
  @@map("company_member_roles")
}

model CompanyMemberScope {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  companyId        String           @db.Uuid
  companyMemberId  String           @db.Uuid
  scopeType        CompanyScopeType
  scopeKey         String           @default("*") @db.VarChar(120)
  conditions       Json?            @db.JsonB
  validFrom        DateTime         @default(now()) @db.Timestamptz(6)
  validUntil       DateTime?        @db.Timestamptz(6)
  assignedByUserId String?          @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  companyMember    CompanyMember    @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)

  @@unique([companyMemberId, scopeType, scopeKey])
  @@index([tenantId, companyId, scopeType, scopeKey, validUntil])
  @@map("company_member_scopes")
}

model CompanyOwnership {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  companyId        String        @db.Uuid
  companyMemberId  String        @db.Uuid
  isPrimary        Boolean       @default(false)
  startedAt        DateTime      @default(now()) @db.Timestamptz(6)
  endedAt          DateTime?     @db.Timestamptz(6)
  assignedByUserId String?       @db.Uuid
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companyMember    CompanyMember @relation("OwnershipMember", fields: [companyMemberId], references: [id], onDelete: Restrict)
  assignedBy       User?         @relation("OwnershipAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, companyId, endedAt])
  @@index([companyMemberId, endedAt])
  @@map("company_ownerships")
}




model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  companyId          String?            @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle
  startsAt           DateTime           @db.Timestamptz(6)
  trialEndsAt        DateTime?          @db.Timestamptz(6)
  currentPeriodStart DateTime           @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @db.Timestamptz(6)
  graceEndsAt        DateTime?          @db.Timestamptz(6)
  cancelledAt        DateTime?          @db.Timestamptz(6)
  autoRenew          Boolean            @default(true)
  priceSnapshot      Json               @db.JsonB
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  suspendedAt        DateTime? @db.Timestamptz(6)
  pastDueEndsAt       DateTime? @db.Timestamptz(6)
  suspensionExpiresAt DateTime? @db.Timestamptz(6)
  isComplimentary    Boolean   @default(false)
  events             SubscriptionEvent[]
  billings           Billing[]
  invoices           Invoice[]
  payments           Payment[]


  @@index([tenantId, status, currentPeriodEnd])
  @@index([companyId, status, currentPeriodEnd])
  @@map("subscriptions")

  @@index([status, trialEndsAt])
  @@index([status, pastDueEndsAt])
  @@index([status, graceEndsAt])
  @@index([status, suspensionExpiresAt])
}

model Billing {
  id                  String        @id @default(uuid()) @db.Uuid

  tenantId            String        @db.Uuid
  companyId           String?       @db.Uuid
  subscriptionId      String        @db.Uuid

  status              BillingStatus @default(PENDING)

  billingCycle        BillingCycle
  currencyCode        String        @db.Char(3)

  amount              Decimal       @db.Decimal(20, 4)

  periodStart         DateTime      @db.Timestamptz(6)
  periodEnd           DateTime      @db.Timestamptz(6)

  dueAt               DateTime      @db.Timestamptz(6)

  processedAt         DateTime?     @db.Timestamptz(6)
  failedAt            DateTime?     @db.Timestamptz(6)
  cancelledAt         DateTime?     @db.Timestamptz(6)

  attemptCount        Int           @default(0)
  nextAttemptAt       DateTime?     @db.Timestamptz(6)

  idempotencyKey      String        @unique @db.VarChar(200)

  priceSnapshot      Json          @db.JsonB

  metadata            Json?         @db.JsonB

  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company             Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subscription        Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  attempts            BillingAttempt[]
  invoice             Invoice?
  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([tenantId, status, dueAt])
  @@index([companyId, status, dueAt])
  @@index([subscriptionId, periodStart, periodEnd])
  @@index([status, nextAttemptAt])
  @@map("billings")
}














model BillingAttempt {
  id                String               @id @default(uuid()) @db.Uuid

  billingId         String               @db.Uuid

  attemptNumber     Int

  status            BillingAttemptStatus @default(STARTED)

  attemptedAt       DateTime             @default(now()) @db.Timestamptz(6)
  completedAt       DateTime?            @db.Timestamptz(6)

  failureCode       String?              @db.VarChar(100)
  failureMessage    String?              @db.Text

  idempotencyKey    String               @unique @db.VarChar(200)

  metadata          Json?                @db.JsonB

  createdAt         DateTime             @default(now()) @db.Timestamptz(6)

  billing           Billing              @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@unique([billingId, attemptNumber])
  @@index([billingId, createdAt])
  @@index([status, attemptedAt])
  @@map("billing_attempts")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid

  tenantId       String        @db.Uuid
  companyId      String?       @db.Uuid
  subscriptionId String        @db.Uuid
  billingId      String        @unique @db.Uuid

  invoiceNumber  String        @unique @db.VarChar(40)

  status         InvoiceStatus @default(DRAFT)

  currencyCode   String        @db.Char(3)
  subtotal       Decimal       @db.Decimal(20, 4)
  discountAmount Decimal       @default(0) @db.Decimal(20, 4)
  taxAmount      Decimal       @default(0) @db.Decimal(20, 4)
  totalAmount    Decimal       @db.Decimal(20, 4)

  priceSnapshot  Json          @db.JsonB

  issuedAt       DateTime?     @db.Timestamptz(6)
  dueAt          DateTime      @db.Timestamptz(6)
  paidAt         DateTime?     @db.Timestamptz(6)
  cancelledAt    DateTime?     @db.Timestamptz(6)
  voidedAt       DateTime?     @db.Timestamptz(6)

  metadata       Json?         @db.JsonB

  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  billing        Billing       @relation(fields: [billingId], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@index([tenantId, status, dueAt])
  @@index([companyId, status])
  @@index([subscriptionId, createdAt])
  @@map("invoices")
}

model InvoiceSequence {
  yearKey    String @id @db.VarChar(4)
  lastNumber Int    @default(0)

  @@map("invoice_sequences")
}

model Payment {
  id                     String          @id @default(uuid()) @db.Uuid

  tenantId               String          @db.Uuid
  companyId              String?         @db.Uuid
  subscriptionId         String          @db.Uuid
  invoiceId              String          @db.Uuid

  provider               PaymentProvider
  status                 PaymentStatus   @default(PENDING)

  currencyCode           String          @db.Char(3)
  amount                 Decimal         @db.Decimal(20, 4)

  providerTransactionId  String          @unique @db.VarChar(64)
  gatewayReference       String?         @unique @db.VarChar(64)

  idempotencyKey         String          @unique @db.VarChar(200)

  failureReason          String?         @db.Text

  rawInitiateResponse    Json?           @db.JsonB
  rawVerifyResponse      Json?           @db.JsonB
  metadata               Json?           @db.JsonB

  initiatedAt            DateTime?       @db.Timestamptz(6)
  succeededAt            DateTime?       @db.Timestamptz(6)
  failedAt               DateTime?       @db.Timestamptz(6)
  cancelledAt            DateTime?       @db.Timestamptz(6)

  createdAt              DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(6)

  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company                Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subscription            Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoice                Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([companyId, status])
  @@index([invoiceId, status])
  @@map("payments")
}




model SubscriptionEvent {
  id              String              @id @default(uuid()) @db.Uuid
  subscriptionId  String              @db.Uuid
  tenantId        String              @db.Uuid
  companyId       String?             @db.Uuid
  fromStatus      SubscriptionStatus?
  toStatus        SubscriptionStatus
  reason          String              @db.VarChar(160)
  source          String              @db.VarChar(40)
  actorUserId     String?             @db.Uuid
  idempotencyKey  String?             @unique @db.VarChar(200)
  metadata        Json?               @db.JsonB
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  subscription    Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([tenantId, companyId, createdAt])
  @@map("subscription_events")
}
model Invitation {
  id            String           @id @default(uuid()) @db.Uuid
  type          InvitationType
  status        InvitationStatus @default(PENDING)
  tenantId      String?          @db.Uuid
  companyId     String?          @db.Uuid
  invitedUserId String?          @db.Uuid
  email         String           @db.VarChar(200)
  tokenHash     String           @unique @db.Char(64)
  expiresAt     DateTime         @db.Timestamptz(6)
  acceptedAt    DateTime?        @db.Timestamptz(6)
  revokedAt     DateTime?        @db.Timestamptz(6)
  sentByUserId  String?          @db.Uuid
  metadata      Json?            @db.JsonB
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  company       Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedUser   User?            @relation("InvitationForUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  sentBy        User?            @relation("InvitationSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([email, status, expiresAt])
  @@index([tenantId, companyId, status])
  @@map("invitations")
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String?        @db.Uuid
  companyId   String?        @db.Uuid
  actorUserId String?        @db.Uuid
  actorType   AuditActorType @default(SYSTEM)
  action      String         @db.VarChar(120)
  entityType  String         @db.VarChar(100)
  entityId    String?        @db.Uuid
  requestId   String?        @db.Uuid
  ipAddress   String?        @db.Inet
  userAgent   String?        @db.Text
  beforeData  Json?          @db.JsonB
  afterData   Json?          @db.JsonB
  metadata    Json?          @db.JsonB
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, companyId, entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Permission {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(120)
  moduleCode  String     @db.VarChar(80)
  resource    String     @db.VarChar(80)
  action      String     @db.VarChar(80)
  name        String     @db.VarChar(160)
  description String?    @db.Text
  isSystem    Boolean    @default(true)
    status      PermissionStatus @default(ACTIVE)

  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  platformRoles PlatformRolePermission[]
  companyRoles  CompanyRolePermission[]

  @@unique([moduleCode, resource, action])
  @@index([moduleCode, status])
  @@index([resource, action, status])
  @@map("permissions")
}

model PlatformRolePermission {
  platformRoleId   String           @db.Uuid
  permissionId     String           @db.Uuid
  effect           PermissionEffect @default(ALLOW)
  conditions       Json?            @db.JsonB
  assignedAt       DateTime         @default(now()) @db.Timestamptz(6)
  assignedByUserId String?          @db.Uuid

  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([platformRoleId, permissionId])
  @@index([permissionId, effect])
  @@map("platform_role_permissions")
}

model CompanyRolePermission {
  companyRoleId    String           @db.Uuid
  permissionId     String           @db.Uuid
  effect           PermissionEffect @default(ALLOW)
  conditions       Json?            @db.JsonB
  assignedAt       DateTime         @default(now()) @db.Timestamptz(6)
  assignedByUserId String?          @db.Uuid

  companyRole CompanyRole @relation(fields: [companyRoleId], references: [id], onDelete: Cascade)
  permission  Permission  @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([companyRoleId, permissionId])
  @@index([permissionId, effect])
  @@map("company_role_permissions")
}
